{
  "appId": "com.geoshield.app",
  "productName": "GeoShield",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "electron/**/*",
    "frontend/dist/**/*",
    "branding/**/*"
  ],
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "branding/team_logo.png",
    "category": "Education"
  },
  "win": {
    "target": ["nsis"],
    "icon": "branding/team_logo.png"
  },
  "mac": {
    "target": ["dmg"],
    "icon": "branding/team_logo.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "GeoShield"
  }
}
