{
  "name": "geoshield",
  "version": "1.0.0",
  "description": "GeoShield - AI-Based Landslide Risk Monitoring System for NER",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --config electron-builder.json",
    "build:mac": "electron-builder --mac --config electron-builder.json",
    "build:linux": "electron-builder --linux --config electron-builder.json",
    "build:all": "electron-builder -wml --config electron-builder.json",
    "test": "cd backend && python3 tests/test_e2e.py"
  },
  "build": {
    "appId": "com.geoshield.app",
    "productName": "GeoShield",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "branding/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "branding/team_logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GeoShield"
    }
  },
  "author": "Team GeoShield <team@geoshield.dev>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
